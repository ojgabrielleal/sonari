Table users [headercolor: #175e7a] {
	id integer [ pk, increment, not null, unique ]
	uuid char(36) [ not null ]
	is_active boolean [ not null, default: true ]
	username varchar(255) [ not null ]
	password varchar(255) [ not null ]
	name varchar(255) [ not null ]
	nickname varchar(255)
	avatar varchar(255)
	created_at timestamp [ not null ]
	updated_at timestamp [ not null ]
}

Table programs [headercolor: #175e7a] {
	id integer [ pk, increment, not null, unique ]
	uuid char(36) [ not null ]
	user_id integer [ not null ]
	is_active boolean [ not null, default: true ]
	name varchar(255) [ not null ]
	description longtext
	cover varchar(255)
	created_at timestamp [ not null ]
	updated_at timestamp [ not null ]

	indexes {
		(user_id) [ name: 'programs_index_0' ]
	}
}

Table playlists [headercolor: #175e7a] {
	id integer [ pk, increment, not null, unique ]
	uuid char(36) [ not null ]
	user_id integer [ not null ]
	is_active boolean [ not null, default: true ]
	type playlist_type_t [ not null ]
	name varchar(255) [ not null ]
	description longtext
	cover varchar(255)
	settings json
	created_at timestamp [ not null ]
	updated_at timestamp [ not null ]

	indexes {
		(user_id) [ name: 'playlists_index_1' ]
	}
}

Table musics [headercolor: #175e7a] {
	id integer [ pk, increment, not null, unique ]
	uuid char(36) [ not null ]
	artist varchar(255)
	album varchar(255)
	title varchar(255) [ not null ]
	cover varchar(255)
	file_path varchar(255)
	duration_ms integer
	release_year integer
	created_at timestamp [ not null ]
	updated_at timestamp [ not null ]
}

Table playlist_musics [headercolor: #175e7a] {
	id integer [ pk, increment, not null, unique ]
	playlist_id integer [ not null ]
	music_id integer [ not null ]
	weight integer [ not null, default: 1 ]
	is_active boolean [ not null, default: true ]
	created_at timestamp [ not null ]
	updated_at timestamp [ not null ]

	indexes {
		(playlist_id) [ name: 'playlist_musics_index_2' ]
		(music_id) [ name: 'playlist_musics_index_3' ]
		(playlist_id, music_id) [ name: 'playlist_musics_index_4', unique ]
		(playlist_id, position) [ name: 'playlist_musics_index_5', unique ]
	}
}

Table requests [headercolor: #175e7a] {
	id integer [ pk, increment, not null, unique ]
	uuid char(36) [ not null ]
	listener_ip varchar(45)
	listener_name varchar(255)
	requestable_type requestable_type_t [ not null ]
	requestable_id integer [ not null ]
	music_id integer [ not null ]
	status request_status_t [ not null, default: pending ]
	requested_at timestamp [ not null ]
	processed_at timestamp

	indexes {
		(requestable_type, requestable_id) [ name: 'requests_index_6' ]
		(music_id) [ name: 'requests_index_7' ]
		(status) [ name: 'requests_index_8' ]
	}
}

Ref fk_programs_user_id_users {
	programs.user_id > users.id [ delete: cascade, update: cascade ]
}

Ref fk_playlists_user_id_users {
	playlists.user_id > users.id [ delete: cascade, update: cascade ]
}

Ref fk_playlist_musics_playlist_id_playlists {
	playlist_musics.playlist_id > playlists.id [ delete: cascade, update: cascade ]
}

Ref fk_playlist_musics_music_id_musics {
	playlist_musics.music_id > musics.id [ delete: cascade, update: cascade ]
}

Ref fk_requests_music_id_musics {
	requests.music_id > musics.id [ delete: cascade, update: no action ]
}